# Analytics — preencha localmente (.env) e nunca commite valores reais.
# Deixe vazio para não carregar o respectivo script (sem impacto em build/console).

# Meta Pixel ID — Meta Events Manager > Fontes de dados > seu Pixel > detalhes
VITE_META_PIXEL_ID=

# GA4 Measurement ID (G-XXXXXXX) — GA4 Admin > Data Streams > seu stream de web
VITE_GA4_ID=
